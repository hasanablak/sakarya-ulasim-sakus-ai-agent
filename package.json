{
  "name": "sakarya-ulasim-sakus-ai-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @sakus/api\" \"npm run dev -w @sakus/web\"",
    "ingest": "npm run ingest -w @sakus/scraper --",
    "live": "npm run live -w @sakus/scraper --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
